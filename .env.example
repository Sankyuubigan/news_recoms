# ============================================================
# NewsRecoms — пример переменных окружения для пайплайна
# Скопируй в pipeline/.env для локального запуска.
# В GitHub Actions всё это задаётся через Secrets.
# ============================================================

# --- Где лежат данные (ветка `data`, чекаутится в локальную папку) ---
# По умолчанию ../data_repo. Можно переопределить флагом --data-dir.
DATA_DIR=../data_repo

# --- LLM-провайдеры (порядок = приоритет) ---
# Все провайдеры должны поддерживать OpenAI-совместимый протокол.
# max_batch_size — сколько постов максимум в одном запросе.
# При failover роутер автоматически дробит батч под лимит живого провайдера.
#
# ВАЖНО для GitHub Secrets:
#   Значение секрета LLM_PROVIDERS_JSON вставляется БЕЗ внешних кавычек —
#   оно должно начинаться с «[» и заканчиваться «]». Если обернуть в '...'
#   (как принято в .env), пайплайн напишет об этом в логах запуска.
#
# Поля провайдера:
#   name            — уникальное имя; несколько ключей одного вендора = разные имена
#   base_url        — OpenAI-совместимый адрес
#   api_key         — настоящий ключ (заготовки вида YOUR_... отклоняются на старте)
#   model           — одна модель
#   models          — НЕОБЯЗАТЕЛЬНО: список моделей по приоритету, напр.
#                     ["gemini-2.5-flash", "gemini-2.5-flash-lite"].
#                     Если модель выпилена у провайдера (404) — роутер сам
#                     переключится на следующую, не трогая остальных провайдеров.
#                     Можно писать строкой через запятую: "m1, m2"
#   json_mode       — "json_object" (по умолчанию) | "none".
#                     Если провайдер не умеет response_format, роутер один раз
#                     повторит запрос без него и запомнит это до конца прогона.
#   max_batch_size  — 1..200
#   rpm_delay_sec   — пауза между запросами к этому провайдеру
#   timeout_sec     — таймаут одного запроса
LLM_PROVIDERS_JSON='[
  {
    "name": "gemini-flash-primary",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "api_key": "YOUR_GEMINI_KEY_1",
    "models": ["gemini-2.5-flash", "gemini-2.5-flash-lite"],
    "max_batch_size": 30,
    "rpm_delay_sec": 4.0,
    "timeout_sec": 90,
    "json_mode": "json_object"
  },
  {
    "name": "gemini-flash-account-2",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "api_key": "YOUR_GEMINI_KEY_2",
    "model": "gemini-2.5-flash",
    "max_batch_size": 30,
    "rpm_delay_sec": 4.0,
    "timeout_sec": 90,
    "json_mode": "json_object"
  },
  {
    "name": "groq-llama70b",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key": "YOUR_GROQ_KEY",
    "model": "llama-3.3-70b-versatile",
    "max_batch_size": 8,
    "rpm_delay_sec": 2.5,
    "timeout_sec": 45,
    "json_mode": "json_object"
  },
  {
    "name": "openrouter-free",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key": "YOUR_OPENROUTER_KEY",
    "model": "meta-llama/llama-3.3-70b-instruct:free",
    "max_batch_size": 8,
    "rpm_delay_sec": 3.5,
    "timeout_sec": 60,
    "json_mode": "none"
  }
]'

# Проверить конфиг, не запуская пайплайн:
#   python check_llm.py              # из env/.env
#   python check_llm.py file.json    # из файла
# Покажет все ошибки сразу и список провайдеров с отпечатками ключей (сами ключи не печатает).

# --- YouTube deep summary (опционально, экономит квоту) ---
GEMINI_VIDEO_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.5-flash
YOUTUBE_MAX_DEEP_PER_RUN=3

# --- Telegram-алерты для постов 9-10/10 (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Поведение ---
HTTP_TIMEOUT_SEC=15
MAX_ITEMS_PER_SOURCE=25
DRY_RUN=false
