# ============================================================
# NewsRecoms — переменные окружения пайплайна
# ============================================================

# ------------------------------------------------------------
# КАК ЗАДАВАТЬ ПРОВАЙДЕРОВ (два способа)
#
# СПОСОБ 1 (рекомендуемый) — файл pipeline/providers.json + короткие секреты.
#   Структура провайдеров лежит обычным файлом в репозитории: её правишь
#   в веб-интерфейсе GitHub (Edit → Commit), никаких секретов внутри.
#   Вместо ключа в файле стоит ссылка:  "api_key_env": "GEMINI_KEY_1"
#   А сами ключи — отдельными короткими секретами репозитория:
#       GEMINI_KEY_1, GEMINI_KEY_2, GROQ_KEY, OPENROUTER_KEY
#   Заменить ключ = обновить один секрет. Структуру менять = править файл.
#
# СПОСОБ 2 (старый) — весь JSON одной строкой в секрете LLM_PROVIDERS_JSON.
#   Работает, но в вебе GitHub такое значение не отредактировать, только
#   заменять целиком. Оставлен для совместимости.
# ------------------------------------------------------------

# --- Где лежат данные (ветка `data`, чекаутится в локальную папку) ---
DATA_DIR=../data_repo

# --- Ключи провайдеров (для локального запуска; в CI это Secrets) ---
GEMINI_KEY_1=
GEMINI_KEY_2=
GROQ_KEY=
OPENROUTER_KEY=

# --- Старый способ целиком одним JSON (необязательно) ---
# Если задан и непустой — имеет приоритет над pipeline/providers.json.
# В GitHub Secrets вставлять БЕЗ внешних кавычек: от «[» до «]».
# LLM_PROVIDERS_JSON='[...]'

# Поля pipeline/providers.json:
#   name            — уникальное имя; несколько ключей одного вендора = разные имена
#   base_url        — OpenAI-совместимый адрес
#   api_key_env     — имя переменной/секрета с ключом (рекомендуется)
#   api_key         — ключ прямо в файле (только для локальной отладки, НЕ коммитить)
#   model           — одна модель
#   models          — список моделей по приоритету: при 404 роутер переключится
#                     на следующую модель ТОГО ЖЕ ключа, не трогая других провайдеров
#                     (можно строкой через запятую: "m1, m2")
#   json_mode       — "json_object" (по умолчанию) | "none".
#                     Если провайдер не умеет response_format, роутер один раз
#                     повторит запрос без него и запомнит это до конца прогона.
#   max_batch_size  — 1..200
#   rpm_delay_sec   — пауза между запросами к этому провайдеру
#   timeout_sec     — таймаут одного запроса

# Проверить конфиг, не запуская пайплайн:
#   python check_llm.py              # providers.json (или LLM_PROVIDERS_JSON)
#   python check_llm.py file.json    # из конкретного файла
# Покажет все ошибки сразу и таблицу провайдеров с отпечатками ключей (ключи не печатает).

# --- YouTube deep summary (опционально, экономит квоту) ---
GEMINI_VIDEO_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.5-flash
YOUTUBE_MAX_DEEP_PER_RUN=3

# --- Telegram-алерты для постов 9-10/10 (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Поведение ---
HTTP_TIMEOUT_SEC=15
MAX_ITEMS_PER_SOURCE=25
DRY_RUN=false
